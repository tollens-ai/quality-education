 "lines": [
  {
   "section": "Intro",
   "start": 0.0,
   "end": 4.04,
   "text": "You said make it good, so I made it good!"
  },
  {
   "section": "Verse 1",
   "start": 4.52,
   "end": 8.0,
   "text": "Confetti cannons every time you floss,"
  },
  {
   "section": "Verse 1",
   "start": 8.0,
   "end": 10.76,
   "text": "2FA to use your gym log,"
  },
  {
   "section": "Verse 1",
   "start": 10.76,
   "end": 13.2,
   "text": "Kubernetes scaling up your blog,"
  },
  {
   "section": "Verse 1",
   "start": 13.2,
   "end": 15.64,
   "text": "twelve subagents working round the clock."
  },
  {
   "section": "Verse 1",
   "start": 15.64,
   "end": 17.04,
   "text": "Did I do it wrong?"
  },
  {
   "section": "Verse 1",
   "start": 17.04,
   "end": 18.66,
   "text": "Oops, your quota's gone!"
  },
  {
   "section": "Verse 1",
   "start": 18.66,
   "end": 20.8,
   "text": "Guess I didn't ask!"
  },
  {
   "section": "Pre-chorus",
   "start": 20.8,
   "end": 22.32,
   "text": "You didn't tell me who it's for,"
  },
  {
   "section": "Pre-chorus",
   "start": 22.32,
   "end": 24.0,
   "text": "you didn't tell me what they want."
  },
  {
   "section": "Pre-chorus",
   "start": 24.0,
   "end": 25.04,
   "text": "I can't read your mind,"
  },
  {
   "section": "Pre-chorus",
   "start": 25.04,
   "end": 27.2,
   "text": "I'm only reading your prompt."
  },
  {
   "section": "Chorus",
   "start": 27.2,
   "end": 29.4,
   "text": "Make it good for who? (ooh-ooh-ooh)"
  },
  {
   "section": "Chorus",
   "start": 29.4,
   "end": 32.72,
   "text": "Make it good for what? (ahh-ahh-ahh)"
  },
  {
   "section": "Chorus",
   "start": 32.72,
   "end": 35.44,
   "text": "Fast to run, or sturdy, or cheap?"
  },
  {
   "section": "Chorus",
   "start": 35.44,
   "end": 38.08,
   "text": "Wow for a week, or built to keep?"
  },
  {
   "section": "Chorus",
   "start": 38.08,
   "end": 40.76,
   "text": "Make it good for who? (ooh-ooh-ooh)"
  },
  {
   "section": "Chorus",
   "start": 40.76,
   "end": 43.62,
   "text": "Make it good for what? (ahh-ahh-ahh)"
  },
  {
   "section": "Chorus",
   "start": 43.62,
   "end": 46.46,
   "text": "Ship it now, or polish it slow?"
  },
  {
   "section": "Chorus",
   "start": 46.46,
   "end": 50.48,
   "text": "Does what they need, or steals the show?"
  },
  {
   "section": "Verse 2",
   "start": 51.0,
   "end": 53.38,
   "text": "Product demo? Wow them fast."
  },
  {
   "section": "Verse 2",
